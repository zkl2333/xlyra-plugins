{
  "apiVersion": 1,
  "hostApi": 1,
  "id": "zkl2333.free-opencode",
  "kind": "site_provider",
  "name": "OpenCode Zen Free Lane",
  "description": "OpenCode Zen 免费车道（opencode.ai/inference，匿名凭证 public）。插件自带 Bun 传输 profile、动态 project/session 头与官方 body 整形；客户端工具以可逆 custom_ 线上名收编并在响应流还原，免费目录过滤与限流分类内置。",
  "version": "0.3.1",
  "license": "MIT",
  "xlyra": ">=1.19.0",
  "icon": "assets/icon.png",
  "permissions": [
    "storage"
  ],
  "transport": {
    "profile": "bun"
  },
  "siteProvider": {
    "siteType": "zkl2333.free-opencode/gateway",
    "display": {
      "name": {
        "zh": "OpenCode Zen 免费车道",
        "en": "OpenCode Zen Free Lane"
      },
      "subtitle": {
        "zh": "免密免费模型（插件自带 Bun 传输与动态身份）",
        "en": "Keyless free models (Bun transport and dynamic identity included)"
      }
    },
    "hosts": [
      "opencode.ai"
    ],
    "credential": {
      "model": "api_key"
    },
    "protocol": {
      "kind": "openai_chat",
      "path": "/v1/chat/completions",
      "officialBaseURL": "https://opencode.ai/inference",
      "defaultEndpointTypes": [
        "openai"
      ]
    },
    "models": {
      "path": "/v1/models",
      "auth": "bearer"
    },
    "request": {
      "headers": {
        "user-agent": "opencode/latest/2.1.1/cli",
        "x-opencode-client": "cli",
        "x-opencode-project": "{{random.hex:40}}"
      }
    }
  },
  "exports": [
    "classify",
    "listModels",
    "rewritePayload",
    "signRequest",
    "transformStream"
  ]
}
